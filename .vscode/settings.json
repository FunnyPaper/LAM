{
    "rust-analyzer.cargo.features": [],
    "rust-analyzer.cargo.buildScripts.enable": false,
    "rust-analyzer.linkedProjects": ["./tauri/Cargo.toml"],
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        "**/.dart_tool": true,
        "**/target/**": true,
        "**/node_modules/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.dart_tool": true,
        "**/target": true
    }
}